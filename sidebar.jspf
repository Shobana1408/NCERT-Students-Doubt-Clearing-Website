<%-- Expects: ctx, studentNavActive --%>
<div class="col-lg-3 col-xl-2">
  <aside class="nc-dash-sidebar p-3 p-lg-4">
    <p class="nc-sidebar-label">Menu</p>
    <nav class="nav flex-column gap-1">
      <a class="nav-link d-flex align-items-center gap-2 ${studentNavActive == 'dashboard' ? 'active' : ''}" href="${ctx}/student/dashboard">
        <i class="bi bi-house-door fs-5"></i> Overview
      </a>
      <a class="nav-link d-flex align-items-center gap-2 ${studentNavActive == 'ask' ? 'active' : ''}" href="${ctx}/student/ask">
        <i class="bi bi-lightbulb fs-5"></i> Ask a doubt
      </a>
      <a class="nav-link d-flex align-items-center gap-2 ${studentNavActive == 'history' ? 'active' : ''}" href="${ctx}/student/history">
        <i class="bi bi-journal-text fs-5"></i> Doubt history
      </a>
    </nav>
    <div class="mt-4 p-3 nc-sidebar-tip">
      <div class="d-flex align-items-start gap-2">
        <i class="bi bi-stars text-warning fs-4"></i>
        <div>
          <p class="small fw-bold mb-1 text-dark">Tip</p>
          <p class="small text-muted mb-0">Upload a clear photo of your textbook question for best OCR results.</p>
        </div>
      </div>
    </div>
  </aside>
</div>
